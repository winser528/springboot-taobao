            <SCRIPT type=text/javascript>
                /**
                 * 提交评论信息
                 */
                function submitCommentlogin(frm) {
                    var cmt = new Object;
                    cmt.user_name = frm.elements['uname'].value;
                    cmt.password = frm.elements['pass'].value;
                    cmt.pid = frm.elements['pid'].value;
                    cmt.content = frm.elements['content'].value;
                    for (i = 0; i < frm.elements['comment_rank'].length; i++) {
                        if (frm.elements['comment_rank'][i].checked) {
                            cmt.ranka = frm.elements['comment_rank'][i].value;
                        }
                    }
                    var msg = '';
                    if (cmt.user_name.length == 0) {
                        msg = "请输入用户名";
                        document.getElementById("user_name_error").innerHTML = "请输入用户名";
                    }
                    if (cmt.password.length == 0) {
                        msg = "请输入密码";
                        document.getElementById("pass_error").innerHTML = "请输入密码";
                    }
                    if (cmt.content.length == 0) {
                        msg = "请填写评论内容";
                        document.getElementById("content_error").innerHTML = "请填写评论内容";
                    }
                    if (cmt.user_name.length != 0) {
                        document.getElementById("user_name_error").innerHTML = "";
                    }
                    if (cmt.password.length != 0) {
                        document.getElementById("pass_error").innerHTML = "";
                    }
                    if (cmt.content.length != 0) {
                        document.getElementById("content_error").innerHTML = "";
                    }

                    document.getElementById("login_error").innerHTML = '';

                    if (msg.length > 0) {
                        return false;
                    } else {
                        var xmlHttp = getXMLRequester();
                        var url = "comment.php?act=login&pid=" + cmt.pid + "&mmmemo=" + encodeURI(cmt.content) + "&mrankd=" + (cmt.ranka)
                        url = url + "&username=" + encodeURI(cmt.user_name) + "&password=" + encodeURI(cmt.password) + "&timeStamp=" + new Date().getMilliseconds()
                        //alert(url);
                        xmlHttp.onreadystatechange = function () {
                            if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
                                var xmlstr = xmlHttp.responseText;
                                var strarray = xmlstr.split("|");
                                alert(strarray[1]);

                            }
                        }
                        xmlHttp.open("GET", url, true)
                        xmlHttp.send(null)
                        return true;
                    }
                }
